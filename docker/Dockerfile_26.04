FROM ubuntu:resolute

ARG UID=10001
ARG USER=aicex

RUN ln -snf /usr/share/zoneinfo/$CONTAINER_TIMEZONE /etc/localtime && echo $CONTAINER_TIMEZONE > /etc/timezone

RUN apt-get update && \
    apt-get -y install --no-install-recommends sudo make ngspice verilator pandoc ca-certificates lsb-release g++ \
    openssh-server iverilog yosys klayout  \
    vim curl xterm gawk bash python3-pip python3-dev libxft2 libxss1 m4 libx11-dev tcl-dev tk-dev \
    libxaw7 mesa-common-dev libgl-dev libglu1-mesa-dev  zlib1g-dev libncurses-dev libqhull-dev \
    tcsh flex bison \
    texlive-latex-base texlive-latex-recommended texlive-fonts-recommended lmodern librsvg2-bin \
    git libxrender1 libxrender-dev \
    libxcb1 libx11-xcb-dev libcairo2 libcairo2-dev \
    libxpm4  \
    vim-gtk3 tcl-tclreadline libxpm-dev automake libtool libxaw7-dev libreadline-dev gperf \
    xz-utils liblzma-dev libgtk2.0-dev python3-pil.imagetk python3-venv gosu &&\
    apt-get autoremove --purge -y && \
    apt-get clean && \
    apt-get autoclean && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -u ${UID}  -s /bin/bash ${USER}
RUN echo "${USER}:${USER}" | chpasswd && usermod -aG sudo ${USER}
RUN echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

RUN echo  "X11UseLocalhost no\n" >> /etc/ssh/sshd_config
COPY .spiceinit .spiceinit

EXPOSE 22

ARG DEBIAN_FRONTEND=noninteractive

RUN test -d /opt || mkdir /opt
RUN test -d /opt/eda || mkdir /opt/eda

WORKDIR /opt/
RUN sudo chown -R ${USER}:${USER} /opt
USER ${USER}

ENV LD_LIBRARY_PATH=/opt/eda/lib
ENV PATH=/opt/eda/bin:~/.local/bin:$PATH

RUN sudo mkdir /opt/eda/python3
RUN sudo chown -R ${USER}:${USER} /opt/eda/python3/
RUN python3 -m venv /opt/eda/python3
ENV PATH=/opt/eda/bin:/opt/eda/python3/bin:~/.local/bin:$PATH

RUN sudo mkdir --parents /opt/pdk/share/

COPY tests/Makefile tests/patch_legacy_c.py tests/
WORKDIR /opt/tests
RUN sudo make xschem_compile && sudo make xschem_install && sudo make clean
RUN sudo make netgen_compile && sudo make netgen_install && sudo make clean
RUN sudo make magic_compile && sudo make magic_install && sudo make clean
WORKDIR /opt/
#- The PDK is DOWNLOADED, not built: building open_pdks runs magic over
#- every library and was the slowest step of this image. ciel serves the
#- same open_pdks output prebuilt, keyed by open_pdks commit, so the
#- version is pinned here instead of being whatever HEAD was on the day.
#- Only what the flows read: common (libs.tech: magic, netgen, xschem,
#- ngspice, klayout), the primitives and sc_hd. This build was made with
#- magic 8.3.677 (sky130A/.config/nodeinfo.json); MAGIC_VER in
#- tests/Makefile must stay at or above it.
ARG CIEL_SKY130=1689ac3f2dc763876eaf967227c7dfe831b031ae
RUN python3 -m pip install --no-cache-dir ciel && \
    sudo mkdir -p /opt/pdk/share/pdk && sudo chown -R ${USER}:${USER} /opt/pdk && \
    ciel enable --pdk-family sky130 --pdk-root /opt/pdk/share/pdk \
        -l sky130_fd_pr -l sky130_fd_sc_hd ${CIEL_SKY130}

#- changing PIP_REFRESH misses the cache from here down, so a rebuild
#- with a warm cache still installs the CURRENT Python tools: CI once
#- ran on a baked-in cicspi a release behind for a month
ARG PIP_REFRESH=0
RUN python3 -m pip install --no-cache-dir matplotlib cicsim cicconf cicpy cicspi numpy click \
svgwrite pyyaml pandas tabulate wheel setuptools tikzplotlib scipy gdstk pygltflib gdspy

# `triangle` on PyPI ships a Cython-generated triangle/core.c that includes
# longintrepr.h, which was removed in Python 3.12+. Ubuntu 'resolute' ships
# Python 3.14, so the wheel fails to build. Install from upstream with a
# current Cython (no build isolation) so the C is regenerated.
RUN python3 -m pip install --no-cache-dir "cython>=3" && \
    python3 -m pip install --no-cache-dir --no-build-isolation git+https://github.com/drufat/triangle.git




RUN git config --global --add safe.directory /home/aicex
WORKDIR /home/${USER}
RUN mkdir /home/${USER}/.ssh

USER root
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sudo chmod ug+rwx /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
